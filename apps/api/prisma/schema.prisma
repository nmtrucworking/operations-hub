  updatedAt    DateTime      @updatedAt
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  period       KpiPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([definitionId, periodId, membershipId])
  @@index([membershipId])
}

model EvaluationCycle {
  id          String                 @id @default(uuid())
  tenantId    String
  code        String
  name        String
  status      String                 @default("DRAFT")
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments EvaluationAssignment[]

  @@unique([tenantId, code])
}

model EvaluationCriterion {
  id        String             @id @default(uuid())
  tenantId  String
  code      String
  name      String
  component String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions  CriterionVersion[]

  @@unique([tenantId, code])
}

model CriterionVersion {
  id                String              @id @default(uuid())
  criterionId       String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  maxScore          Decimal             @db.Decimal(18, 2)
  calculationMethod String?
  criterion         EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  scores            EvaluationScore[]

  @@index([criterionId])
}

model EvaluationAssignment {
  id                    String            @id @default(uuid())
  cycleId               String
  subjectMembershipId   String
  evaluatorMembershipId String
  status                String            @default("PENDING")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  cycle                 EvaluationCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subjectMembership     Membership        @relation("EvaluationSubject", fields: [subjectMembershipId], references: [id], onDelete: Restrict)
  evaluatorMembership   Membership        @relation("EvaluationEvaluator", fields: [evaluatorMembershipId], references: [id], onDelete: Restrict)
  scores                EvaluationScore[]
  result                EvaluationResult?

  @@unique([cycleId, subjectMembershipId, evaluatorMembershipId])
  @@index([subjectMembershipId])
  @@index([evaluatorMembershipId])
}

model EvaluationScore {
  id                 String               @id @default(uuid())
  assignmentId       String
  criterionVersionId String
  score              Decimal              @db.Decimal(18, 2)
  note               String?
  assignment         EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterionVersion   CriterionVersion     @relation(fields: [criterionVersionId], references: [id], onDelete: Restrict)
  evidences          EvaluationEvidence[]

  @@unique([assignmentId, criterionVersionId])
  @@index([criterionVersionId])
}

model EvaluationEvidence {
  id           String          @id @default(uuid())
  scoreId      String
  fileObjectId String
  description  String?
  score        EvaluationScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  fileObject   FileObject      @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@index([scoreId])
  @@index([fileObjectId])
}

model EvaluationResult {
  id             String               @id @default(uuid())
  assignmentId   String               @unique
  totalScore     Decimal              @db.Decimal(18, 2)
  classification String?
  finalizedAt    DateTime?
  assignment     EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Competition {
  id             String                     @id @default(uuid())
  tenantId       String
  name           String
  organizer      String?
  startAt        DateTime?
  endAt          DateTime?
  status         String                     @default("DRAFT")
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participations CompetitionParticipation[]

  @@index([tenantId, status])
}

model CompetitionTeam {
  id                 String                     @id @default(uuid())
  tenantId           String
  name               String
  leaderMembershipId String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaderMembership   Membership?                @relation(fields: [leaderMembershipId], references: [id], onDelete: SetNull)
  members            TeamMember[]
  participations     CompetitionParticipation[]

  @@index([tenantId])
  @@index([leaderMembershipId])
}

model TeamMember {
  teamId       String
  membershipId String
  role         String?
  team         CompetitionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership   Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([teamId, membershipId])
  @@index([membershipId])
}

model CompetitionParticipation {
  id              String                  @id @default(uuid())
  competitionId   String
  teamId          String?
  membershipId    String?
  participantType String
  status          String                  @default("REGISTERED")
  registeredAt    DateTime                @default(now())
  competition     Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team            CompetitionTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  membership      Membership?             @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  submissions     CompetitionSubmission[]
  achievements    Achievement[]

  @@index([competitionId])
  @@index([teamId])
  @@index([membershipId])
}

model CompetitionSubmission {
  id              String                   @id @default(uuid())
  participationId String
  title           String
  fileObjectId    String?
  submittedAt     DateTime?
  participation   CompetitionParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  fileObject      FileObject?              @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([participationId])
  @@index([fileObjectId])
}

model Achievement {
  id              String                   @id @default(uuid())
  participationId String
  title           String
  level           String?
  awardedAt       DateTime?
  participation   CompetitionParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  awards          RecognitionAward[]

  @@index([participationId])
}

model RecognitionAward {
  id            String      @id @default(uuid())
  tenantId      String
  achievementId String
  awardType     String
  grantedAt     DateTime?
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([achievementId])
}

model NotificationTemplate {
  id              String         @id @default(uuid())
  tenantId        String
  code            String
  channel         String
  subjectTemplate String?
  bodyTemplate    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@unique([tenantId, code, channel])
}

model Notification {
  id         String                  @id @default(uuid())
  tenantId   String
  templateId String?
  eventType  String
  payload    Json?
  priority   String                  @default("NORMAL")
  createdAt  DateTime                @default(now())
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   NotificationTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([tenantId, createdAt])
  @@index([templateId])
}

model NotificationRecipient {
  id             String                 @id @default(uuid())
  notificationId String
  membershipId   String?
  userId         String?
  readAt         DateTime?
  notification   Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  membership     Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@index([notificationId])
  @@index([membershipId])
  @@index([userId])
}

model NotificationDelivery {
  id                String                @id @default(uuid())
  recipientId       String
  channel           String
  status            String
  providerMessageId String?
  attemptedAt       DateTime              @default(now())
  recipient         NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([status, attemptedAt])
}

model Announcement {
  id            String    @id @default(uuid())
  tenantId      String
  title         String
  content       String
  audienceScope String
  publishAt     DateTime?
  expireAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishAt])
}

model Dashboard {
  id                String            @id @default(uuid())
  tenantId          String
  name              String
  ownerMembershipId String?
  scope             String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerMembership   Membership?       @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  widgets           DashboardWidget[]

  @@index([tenantId])
  @@index([ownerMembershipId])
}

model DashboardWidget {
  id                 String            @id @default(uuid())
  dashboardId        String
  widgetType         String
  metricDefinitionId String?
  position           Json
  config             Json?
  dashboard          Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  metricDefinition   MetricDefinition? @relation(fields: [metricDefinitionId], references: [id], onDelete: SetNull)

  @@index([dashboardId])
  @@index([metricDefinitionId])
}

model MetricDefinition {
  id           String            @id @default(uuid())
  key          String            @unique
  name         String
  sourceModule String
  calculation  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  widgets      DashboardWidget[]
  snapshots    MetricSnapshot[]
}

model MetricSnapshot {
  id                 String           @id @default(uuid())
  tenantId           String
  metricDefinitionId String
  value              Decimal          @db.Decimal(18, 2)
  dimension          Json?
  capturedAt         DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metricDefinition   MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, capturedAt])
  @@index([metricDefinitionId])
}

model ReportDefinition {
  id              String      @id @default(uuid())
  tenantId        String
  name            String
  queryDefinition Json
  format          String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs            ReportRun[]

  @@index([tenantId])
}

model ReportRun {
  id                      String           @id @default(uuid())
  reportDefinitionId      String
  requestedByMembershipId String?
  status                  String           @default("PENDING")
  startedAt               DateTime?
  completedAt             DateTime?
  reportDefinition        ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  requestedByMembership   Membership?      @relation(fields: [requestedByMembershipId], references: [id], onDelete: SetNull)
  exportFile              ExportFile?

  @@index([reportDefinitionId])
  @@index([requestedByMembershipId])
}

model ExportFile {
  id           String     @id @default(uuid())
  reportRunId  String     @unique
  fileObjectId String
  expiresAt    DateTime?
  reportRun    ReportRun  @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@index([fileObjectId])
}

model AiProviderConfig {
  id              String      @id @default(uuid())
  tenantId        String
  provider        String
  model           String
  secretReference String?
  status          String      @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests        AiRequest[]

  @@index([tenantId, status])
}

model AiPolicy {
  id                  String   @id @default(uuid())
  tenantId            String
  allowedUseCase      String
  dataClassification  String
  humanReviewRequired Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, allowedUseCase])
}

model AiPromptTemplate {
  id        String      @id @default(uuid())
  tenantId  String
  code      String
  version   Int
  template  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests  AiRequest[]

  @@unique([tenantId, code, version])
}

model AiRequest {
  id                    String            @id @default(uuid())
  tenantId              String
  requesterMembershipId String
  providerConfigId      String?
  promptTemplateId      String?
  purpose               String
  inputHash             String
  status                String            @default("PENDING")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterMembership   Membership        @relation(fields: [requesterMembershipId], references: [id], onDelete: Restrict)
  providerConfig        AiProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  promptTemplate        AiPromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  response              AiResponse?
  usageRecord           AiUsageRecord?

  @@index([tenantId, status])
  @@index([requesterMembershipId])
  @@index([providerConfigId])
  @@index([promptTemplateId])
}

model AiResponse {
  id                String       @id @default(uuid())
  aiRequestId       String       @unique
  providerRequestId String?
  content           String
  model             String
  latencyMs         Int?
  createdAt         DateTime     @default(now())
  aiRequest         AiRequest    @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
  feedbacks         AiFeedback[]

  @@index([providerRequestId])
}

model AiUsageRecord {
  id            String    @id @default(uuid())
  aiRequestId   String    @unique
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  estimatedCost Decimal   @default(0) @db.Decimal(18, 6)
  aiRequest     AiRequest @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
}

model AiFeedback {
  id           String     @id @default(uuid())
  aiResponseId String
  membershipId String
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  aiResponse   AiResponse @relation(fields: [aiResponseId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([aiResponseId])
  @@index([membershipId])
}

model AuditEvent {
  id                String         @id @default(uuid())
  tenantId          String?
  actorUserId       String?
  actorMembershipId String?
  action            String
  result            AuditResult    @default(SUCCESS)
  entityType        String?
  entityId          String?
  correlationId     String?
  occurredAt        DateTime       @default(now())
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser         User?          @relation("AuditEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership   Membership?    @relation("AuditEventActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  changes           AuditChange[]
  securityEvent     SecurityEvent?

  @@index([tenantId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([actorMembershipId, occurredAt])
  @@index([entityType, entityId])
  @@index([correlationId])
}

model AuditChange {
  id           String     @id @default(uuid())
  auditEventId String
  field        String
  beforeValue  Json?
  afterValue   Json?
  auditEvent   AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  @@index([auditEventId])
}

model CorrelationContext {
  correlationId String   @id
  requestId     String?
  traceId       String?
  createdAt     DateTime @default(now())

  @@index([requestId])
  @@index([traceId])
}

model SecurityEvent {
  id           String     @id @default(uuid())
  auditEventId String     @unique
  eventType    String
  riskLevel    String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  auditEvent   AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  @@index([eventType, riskLevel])
}

model AuditRetentionPolicy {
  id              String   @id @default(uuid())
  scope           String
  retentionDays   Int
  archiveStrategy String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scope])
}
