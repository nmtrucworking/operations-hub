generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum FinanceTransactionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RECORDED
  VOID
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SELECT_TENANT
  EXPORT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
  ANONYMIZED
}

enum TenantRegistrationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum RolePermissionEffect {
  ALLOW
  DENY
}

enum ModuleDefinitionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

enum TenantModuleStatus {
  ENABLED
  DISABLED
  SUSPENDED
}

enum FinanceAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model User {
  id                          String                   @id @default(uuid())
  email                       String                   @unique
  passwordHash                String
  fullName                    String
  avatarUrl                   String?
  isActive                    Boolean                  @default(true)
  isVerified                  Boolean                  @default(true)
  accountStatus               AccountStatus            @default(ACTIVE)
  platformRole                String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  credential                  Credential?
  profile                     UserProfile?
  sessions                    Session[]
  verificationTokens          VerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  externalIdentities          ExternalIdentity[]
  loginAttempts               LoginAttempt[]           @relation("LoginAttemptUser")
  contacts                    UserContact[]
  userSetting                 UserSetting?
  notificationPreferences     NotificationPreference[]
  accountStatusHistory        AccountStatusHistory[]   @relation("AccountStatusSubject")
  accountStatusChanged        AccountStatusHistory[]   @relation("AccountStatusActor")
  tenantRegistrations         TenantRegistration[]     @relation("TenantRegistrationApplicant")
  reviewedTenantRegistrations TenantRegistration[]     @relation("TenantRegistrationReviewer")
  tenantLifecycleEvents       TenantLifecycleEvent[]   @relation("TenantLifecycleActor")
  memberships                 Membership[]
  notificationRecipients      NotificationRecipient[]
  auditEvents                 AuditEvent[]             @relation("AuditEventActorUser")
  auditLogs                   AuditLog[]               @relation("AuditActor")
  createdRequests             Request[]                @relation("RequestCreator")
  financeCreated              FinanceTransaction[]     @relation("FinanceCreator")
}

model Session {
  id               String         @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]

  @@index([userId])
}

model Tenant {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  status                  TenantStatus             @default(ACTIVE)
  brandColor              String                   @default("#2563eb")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             Membership[]
  tenantRegistrations     TenantRegistration[]
  lifecycleEvents         TenantLifecycleEvent[]
  ownershipAssignments    OwnershipAssignment[]
  organizationProfile     OrganizationProfile?
  organizationUnits       OrganizationUnit[]
  positions               Position[]
  membershipInvitations   MembershipInvitation[]
  skills                  Skill[]
  units                   Unit[]
  roles                   Role[]
  delegationPolicies      DelegationPolicy[]
  tenantPreferences       TenantPreference[]
  notificationPreferences NotificationPreference[]
  requestTypes            RequestType[]
  requests                Request[]
  fileObjects             FileObject[]
  documents               Document[]
  documentTemplates       DocumentTemplate[]
  documentTags            DocumentTag[]
  tenantBranding          TenantBranding?
  brandAssets             BrandAsset[]
  customDomains           CustomDomain[]
  financeAccounts         FinanceAccount[]
  financeTransactions     FinanceTransaction[]
  financeCategories       FinanceCategory[]
  budgets                 Budget[]
  assetCategories         AssetCategory[]
  assets                  Asset[]
  assetLocations          AssetLocation[]
  meetings                Meeting[]
  disciplineRules         DisciplineRule[]
  disciplineCases         DisciplineCase[]
  kpiDefinitions          KpiDefinition[]
  kpiPeriods              KpiPeriod[]
  evaluationCycles        EvaluationCycle[]
  evaluationCriteria      EvaluationCriterion[]
  competitions            Competition[]
  competitionTeams        CompetitionTeam[]
  recognitionAwards       RecognitionAward[]
  notificationTemplates   NotificationTemplate[]
  notifications           Notification[]
  announcements           Announcement[]
  dashboards              Dashboard[]
  dashboardMetrics        DashboardMetric[]
  metricSnapshots         MetricSnapshot[]
  reportDefinitions       ReportDefinition[]
  aiProviderConfigs       AiProviderConfig[]
  aiPolicies              AiPolicy[]
  aiPromptTemplates       AiPromptTemplate[]
  aiRequests              AiRequest[]
  auditEvents             AuditEvent[]
  auditLogs               AuditLog[]
  modules                 TenantModule[]
}

model TenantModule {
  id             String                @id @default(uuid())
  tenantId       String
  key            String
  moduleId       String?
  status         TenantModuleStatus    @default(ENABLED)
  isEnabled      Boolean               @default(true)
  config         Json?
  enabledAt      DateTime?
  disabledAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module         ModuleDefinition?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  configVersions ModuleConfigVersion[]

  @@unique([tenantId, key])
  @@index([moduleId])
}

model Unit {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Unit?           @relation("UnitTree", fields: [parentId], references: [id])
  children  Unit[]          @relation("UnitTree")
  members   MemberProfile[]

  @@index([tenantId])
}

model Membership {
  id                          String                     @id @default(uuid())
  userId                      String
  tenantId                    String
  status                      MembershipStatus           @default(PENDING)
  title                       String?
  joinedAt                    DateTime?
  endedAt                     DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile                     MemberProfile?
  roles                       MembershipRole[]
  approvals                   RequestApproval[]
  ownershipAssignments        OwnershipAssignment[]
  invitedMemberships          MembershipInvitation[]     @relation("MembershipInvitationInviter")
  statusHistory               MembershipStatusHistory[]  @relation("MembershipStatusSubject")
  changedMembershipStatuses   MembershipStatusHistory[]  @relation("MembershipStatusActor")
  memberSkills                MemberSkill[]
  membershipUnits             MembershipUnit[]
  membershipPositions         MembershipPosition[]
  permissionScopes            PermissionScope[]
  createdRequestsAsMembership Request[]                  @relation("RequestCreatorMembership")
  requestComments             RequestComment[]
  changedRequestStatuses      RequestStatusHistory[]
  createdDocumentVersions     DocumentVersion[]
  documentApprovals           DocumentApproval[]
  transactionApprovals        TransactionApproval[]
  financeTransactionsCreated  FinanceTransaction[]       @relation("FinanceCreatorMembership")
  assetAssignments            AssetAssignment[]          @relation("AssetAssignmentHolder")
  assetCheckouts              AssetCheckout[]            @relation("AssetCheckoutBorrower")
  meetingParticipants         MeetingParticipant[]
  attendanceRecords           AttendanceRecord[]
  ownedAgendaItems            AgendaItem[]
  meetingActionItems          MeetingActionItem[]
  disciplineCases             DisciplineCase[]           @relation("DisciplineSubject")
  kpiRecords                  KpiRecord[]
  evaluationSubjects          EvaluationAssignment[]     @relation("EvaluationSubject")
  evaluationAssignments       EvaluationAssignment[]     @relation("EvaluationEvaluator")
  competitionTeamsLed         CompetitionTeam[]
  teamMemberships             TeamMember[]
  competitionParticipations   CompetitionParticipation[]
  notificationRecipients      NotificationRecipient[]
  dashboards                  Dashboard[]
  reportRuns                  ReportRun[]
  aiRequests                  AiRequest[]
  aiFeedbacks                 AiFeedback[]
  auditEvents                 AuditEvent[]               @relation("AuditEventActorMembership")

  @@unique([userId, tenantId])
  @@index([tenantId, status])
}

model MemberProfile {
  id           String     @id @default(uuid())
  membershipId String     @unique
  tenantId     String
  unitId       String?
  studentCode  String?
  phone        String?
  skills       String[]   @default([])
  bio          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit         Unit?      @relation(fields: [unitId], references: [id])

  @@index([tenantId])
}

model Role {
  id                        String                   @id @default(uuid())
  tenantId                  String
  code                      String?
  name                      String
  description               String?
  isSystem                  Boolean                  @default(false)
  isActive                  Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  tenant                    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions               RolePermission[]
  memberships               MembershipRole[]
  approvalStepDefinitions   ApprovalStepDefinition[]
  permissionScopes          PermissionScope[]
  grantorDelegationPolicies DelegationPolicy[]       @relation("DelegationGrantorRole")
  granteeDelegationPolicies DelegationPolicy[]       @relation("DelegationGranteeRole")

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  resource    String?
  action      String?
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  effect       RolePermissionEffect @default(ALLOW)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission           @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime          @default(now())
  expiresAt    DateTime?
  membership   Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopes       PermissionScope[]

  @@id([membershipId, roleId])
}

model RequestType {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  schema           Json?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests         Request[]
  approvalPolicies ApprovalPolicy[]

  @@unique([tenantId, name])
}

model Request {
  id                  String                 @id @default(uuid())
  tenantId            String
  typeId              String?
  creatorId           String
  creatorMembershipId String?
  title               String
  description         String?
  status              RequestStatus          @default(DRAFT)
  payload             Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                RequestType?           @relation(fields: [typeId], references: [id])
  creator             User                   @relation("RequestCreator", fields: [creatorId], references: [id])
  creatorMembership   Membership?            @relation("RequestCreatorMembership", fields: [creatorMembershipId], references: [id], onDelete: SetNull)
  approvals           RequestApproval[]
  attachments         RequestAttachment[]
  comments            RequestComment[]
  statusHistory       RequestStatusHistory[]

  @@index([tenantId, status])
  @@index([creatorMembershipId])
}

model RequestApproval {
  id               String                  @id @default(uuid())
  requestId        String
  membershipId     String
  stepDefinitionId String?
  status           ApprovalStatus          @default(PENDING)
  note             String?
  decidedAt        DateTime?
  createdAt        DateTime                @default(now())
  request          Request                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  membership       Membership              @relation(fields: [membershipId], references: [id])
  stepDefinition   ApprovalStepDefinition? @relation(fields: [stepDefinitionId], references: [id], onDelete: SetNull)

  @@index([stepDefinitionId])
}

model FinanceAccount {
  id            String               @id @default(uuid())
  tenantId      String
  name          String
  currency      String               @default("VND")
  status        FinanceAccountStatus @default(ACTIVE)
  balance       Decimal              @default(0) @db.Decimal(18, 2)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions  FinanceTransaction[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, name])
}

model FinanceTransaction {
  id                  String                   @id @default(uuid())
  tenantId            String
  accountId           String
  categoryId          String?
  createdById         String
  creatorMembershipId String?
  type                FinanceTransactionType
  status              FinanceTransactionStatus @default(DRAFT)
  amount              Decimal                  @db.Decimal(18, 2)
  currency            String                   @default("VND")
  category            String
  description         String?
  occurredAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account             FinanceAccount           @relation(fields: [accountId], references: [id])
  financeCategory     FinanceCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy           User                     @relation("FinanceCreator", fields: [createdById], references: [id])
  creatorMembership   Membership?              @relation("FinanceCreatorMembership", fields: [creatorMembershipId], references: [id], onDelete: SetNull)
  ledgerEntries       LedgerEntry[]
  approvals           TransactionApproval[]
  evidences           FinanceEvidence[]

  @@index([tenantId, status])
  @@index([categoryId])
  @@index([creatorMembershipId])
}

model DashboardMetric {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  label     String
  value     Decimal  @db.Decimal(18, 2)
  unit      String?
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model AuditLog {
  id            String      @id @default(uuid())
  tenantId      String?
  actorId       String?
  action        AuditAction
  result        AuditResult @default(SUCCESS)
  entityType    String?
  entityId      String?
  message       String?
  before        Json?
  after         Json?
  correlationId String?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  actor         User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
}

model Credential {
  id                String   @id @default(uuid())
  userId            String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  sessionId String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExternalIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(uuid())
  userId     String?
  identifier String
  ipAddress  String?
  result     String
  occurredAt DateTime @default(now())
  user       User?    @relation("LoginAttemptUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([identifier, occurredAt])
  @@index([ipAddress, occurredAt])
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserContact {
  id         String   @id @default(uuid())
  userId     String
  type       String
  value      String
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, value])
  @@index([userId])
}

model AccountStatusHistory {
  id         String         @id @default(uuid())
  userId     String
  fromStatus AccountStatus?
  toStatus   AccountStatus
  reason     String?
  changedBy  String?
  changedAt  DateTime       @default(now())
  user       User           @relation("AccountStatusSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?          @relation("AccountStatusActor", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([userId, changedAt])
  @@index([changedBy, changedAt])
}

model TenantRegistration {
  id              String                   @id @default(uuid())
  applicantUserId String
  proposedName    String
  proposedSlug    String
  status          TenantRegistrationStatus @default(SUBMITTED)
  submittedAt     DateTime                 @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  createdTenantId String?
  reviewNote      String?
  metadata        Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  applicant       User                     @relation("TenantRegistrationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewer        User?                    @relation("TenantRegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdTenant   Tenant?                  @relation(fields: [createdTenantId], references: [id], onDelete: SetNull)

  @@unique([proposedSlug])
  @@index([applicantUserId])
  @@index([createdTenantId])
  @@index([status, submittedAt])
}

model TenantLifecycleEvent {
  id         String        @id @default(uuid())
  tenantId   String
  fromStatus TenantStatus?
  toStatus   TenantStatus
  reason     String?
  actorId    String?
  occurredAt DateTime      @default(now())
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?         @relation("TenantLifecycleActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([actorId, occurredAt])
}

model OwnershipAssignment {
  id            String     @id @default(uuid())
  tenantId      String
  membershipId  String
  effectiveFrom DateTime   @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime   @default(now())
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, effectiveFrom])
  @@index([membershipId])
}

model OrganizationProfile {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  displayName  String
  description  String?
  contactEmail String?
  address      String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OrganizationUnit {
  id              String             @id @default(uuid())
  tenantId        String
  parentId        String?
  code            String
  name            String
  status          String             @default("ACTIVE")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          OrganizationUnit?  @relation("OrganizationUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        OrganizationUnit[] @relation("OrganizationUnitTree")
  positions       Position[]
  membershipUnits MembershipUnit[]
  assetLocations  AssetLocation[]
  meetings        Meeting[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
}

model Position {
  id                  String               @id @default(uuid())
  tenantId            String
  unitId              String?
  code                String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                OrganizationUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  membershipPositions MembershipPosition[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([unitId])
}

model MembershipInvitation {
  id                    String      @id @default(uuid())
  tenantId              String
  email                 String
  tokenHash             String
  status                String      @default("PENDING")
  invitedByMembershipId String?
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByMembership   Membership? @relation("MembershipInvitationInviter", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([email])
  @@index([invitedByMembershipId])
}

model MembershipStatusHistory {
  id                    String            @id @default(uuid())
  membershipId          String
  fromStatus            MembershipStatus?
  toStatus              MembershipStatus
  reason                String?
  changedAt             DateTime          @default(now())
  changedByMembershipId String?
  membership            Membership        @relation("MembershipStatusSubject", fields: [membershipId], references: [id], onDelete: Cascade)
  changedByMembership   Membership?       @relation("MembershipStatusActor", fields: [changedByMembershipId], references: [id], onDelete: SetNull)

  @@index([membershipId, changedAt])
  @@index([changedByMembershipId])
}

model Skill {
  id        String        @id @default(uuid())
  tenantId  String
  name      String
  category  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   MemberSkill[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model MemberSkill {
  membershipId String
  skillId      String
  level        String?
  evidence     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([membershipId, skillId])
  @@index([skillId])
}

model MembershipUnit {
  membershipId  String
  unitId        String
  isPrimary     Boolean          @default(false)
  effectiveFrom DateTime         @default(now())
  effectiveTo   DateTime?
  membership    Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit          OrganizationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([membershipId, unitId, effectiveFrom])
  @@index([unitId])
}

model MembershipPosition {
  membershipId  String
  positionId    String
