generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum FinanceTransactionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RECORDED
  VOID
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SELECT_TENANT
  EXPORT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  isActive       Boolean      @default(true)
  isVerified     Boolean      @default(true)
  platformRole   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sessions       Session[]
  memberships    Membership[]
  auditLogs       AuditLog[]   @relation("AuditActor")
  createdRequests Request[]    @relation("RequestCreator")
  financeCreated  FinanceTransaction[] @relation("FinanceCreator")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  brandColor  String       @default("#2563eb")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  units       Unit[]
  roles       Role[]
  requestTypes RequestType[]
  requests    Request[]
  financeAccounts FinanceAccount[]
  financeTransactions FinanceTransaction[]
  dashboardMetrics DashboardMetric[]
  auditLogs   AuditLog[]
  modules     TenantModule[]
}

model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  isEnabled Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Unit?    @relation("UnitTree", fields: [parentId], references: [id])
  children  Unit[]   @relation("UnitTree")
  members   MemberProfile[]

  @@index([tenantId])
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  tenantId  String
  status    MembershipStatus @default(PENDING)
  title     String?
  joinedAt  DateTime?
  endedAt   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile   MemberProfile?
  roles     MembershipRole[]
  approvals RequestApproval[]

  @@unique([userId, tenantId])
  @@index([tenantId, status])
}

model MemberProfile {
  id           String     @id @default(uuid())
  membershipId String    @unique
  tenantId     String
  unitId       String?
  studentCode  String?
  phone        String?
  skills       String[]   @default([])
  bio          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit         Unit?       @relation(fields: [unitId], references: [id])

  @@index([tenantId])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model RequestType {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  schema    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests  Request[]

  @@unique([tenantId, name])
}

model Request {
  id          String        @id @default(uuid())
  tenantId    String
  typeId      String?
  creatorId   String
  title       String
  description String?
  status      RequestStatus @default(DRAFT)
  payload     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        RequestType?  @relation(fields: [typeId], references: [id])
  creator     User          @relation("RequestCreator", fields: [creatorId], references: [id])
  approvals   RequestApproval[]

  @@index([tenantId, status])
}

model RequestApproval {
  id           String         @id @default(uuid())
  requestId    String
  membershipId String
  status       ApprovalStatus @default(PENDING)
  note         String?
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())
  request      Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  membership   Membership     @relation(fields: [membershipId], references: [id])
}

model FinanceAccount {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  currency  String   @default("VND")
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([tenantId, name])
}

model FinanceTransaction {
  id          String                   @id @default(uuid())
  tenantId    String
  accountId   String
  createdById String
  type        FinanceTransactionType
  status      FinanceTransactionStatus @default(DRAFT)
  amount      Decimal                  @db.Decimal(18, 2)
  currency    String                   @default("VND")
  category    String
  description String?
  occurredAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     FinanceAccount           @relation(fields: [accountId], references: [id])
  createdBy   User                     @relation("FinanceCreator", fields: [createdById], references: [id])

  @@index([tenantId, status])
}

model DashboardMetric {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  label     String
  value     Decimal  @db.Decimal(18, 2)
  unit      String?
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model AuditLog {
  id            String      @id @default(uuid())
  tenantId      String?
  actorId       String?
  action        AuditAction
  result        AuditResult @default(SUCCESS)
  entityType    String?
  entityId      String?
  message       String?
  before        Json?
  after         Json?
  correlationId String?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  actor         User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
}
