{
  "name": "operations-hub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @operations-hub/api prisma:generate",
    "db:migrate": "pnpm --filter @operations-hub/api prisma:migrate",
    "db:seed": "pnpm --filter @operations-hub/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
